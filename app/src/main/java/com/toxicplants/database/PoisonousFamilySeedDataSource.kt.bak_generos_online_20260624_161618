package com.toxicplants.database

import android.content.Context
import com.google.gson.Gson
import com.google.gson.reflect.TypeToken

object PoisonousFamilySeedDataSource {

    private const val ALL_ASSET_NAME = "poisonous_family_genera_seed.json"
    private const val PARTIAL_ASSET_NAME = "partially_poisonous_family_genera_seed.json"

    data class SeedItem(
        val familyName: String = "",
        val genusName: String = "",
        val genusSpeciesCount: Int = 0,
        val toxins: String = "",
        val symptoms: String = "",
        val toxicParts: String = "",
        val notes: String = "",
        val catalogType: String = "",
    )

    fun loadAllCatalog(context: Context): List<PoisonousFamilyGenusEntity> =
        loadAsset(context, ALL_ASSET_NAME, PoisonousFamilyCatalogType.ALL)

    fun loadPartialCatalog(context: Context): List<PoisonousFamilyGenusEntity> =
        loadAsset(context, PARTIAL_ASSET_NAME, PoisonousFamilyCatalogType.PARTIAL)

    fun loadEverything(context: Context): List<PoisonousFamilyGenusEntity> =
        loadAllCatalog(context) + loadPartialCatalog(context)

    /** Compatibilidad con versiones anteriores del ViewModel. */
    fun loadAll(context: Context): List<PoisonousFamilyGenusEntity> = loadEverything(context)

    private fun loadAsset(
        context: Context,
        assetName: String,
        fallbackCatalogType: String,
    ): List<PoisonousFamilyGenusEntity> {
        val json = context.assets.open(assetName).bufferedReader().use { it.readText() }
        val type = object : TypeToken<List<SeedItem>>() {}.type
        val seeds: List<SeedItem> = Gson().fromJson(json, type)
        return seeds
            .map { seed ->
                val typeValue = seed.catalogType.ifBlank { fallbackCatalogType }
                PoisonousFamilyGenusEntity(
                    familyName = seed.familyName.trim(),
                    genusName = seed.genusName.trim(),
                    genusSpeciesCount = seed.genusSpeciesCount.coerceAtLeast(0),
                    toxins = seed.toxins.trim(),
                    symptoms = seed.symptoms.trim(),
                    toxicParts = seed.toxicParts.trim(),
                    notes = seed.notes.trim(),
                    catalogType = typeValue,
                    updatedAt = System.currentTimeMillis()
                )
            }
            .filter { it.familyName.isNotBlank() && it.genusName.isNotBlank() }
            .distinctBy { it.catalogType.lowercase() + "|" + it.familyName.lowercase() + "|" + it.genusName.lowercase() }
    }
}
