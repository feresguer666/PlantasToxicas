private fun openGenusWikipedia(context: Context, genusName: String, familyName: String = "") {
    val cleanName = genusName.trim()
    if (cleanName.isBlank()) return

    val ambiguousGenera = setOf("Acis", "Ajax")
    val url = if (cleanName in ambiguousGenera) {
        val query = listOf(cleanName, familyName.trim(), "planta")
            .filter { it.isNotBlank() }
            .joinToString(" ")
        "https://es.wikipedia.org/w/index.php?search=${Uri.encode(query)}"
    } else {
        "https://es.wikipedia.org/wiki/${Uri.encode(cleanName)}"
    }

    runCatching { context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url))) }
}


private fun localGenusName(scientificName: String): String {
    return scientificName
        .trim()
        .split(Regex("\\s+"))
        .firstOrNull()
        ?.trim(' ', ',', '.', ';', ':', '(', ')', '[', ']')
        .orEmpty()
}

